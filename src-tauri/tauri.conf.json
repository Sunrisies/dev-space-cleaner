{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "缓境",
  "version": "0.1.3",
  "identifier": "dev.huanj.cleaner",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [{ "title": "缓境 · 开发空间清理", "width": 1080, "height": 680, "minWidth": 960, "minHeight": 600, "center": true, "fullscreen": false, "maximized": false, "resizable": true, "backgroundColor": "#f7f8fa" }],
    "security": { "csp": "default-src 'self'; connect-src ipc: http://ipc.localhost; img-src 'self' asset: http://asset.localhost data:; style-src 'self' 'unsafe-inline'; font-src 'self'" }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "shortDescription": "开发依赖与构建目录清理工具",
    "category": "Utility",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"],
    "macOS": { "minimumSystemVersion": "11.0" }
  }
}
