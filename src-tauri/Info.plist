<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>NSAppleEventsUsageDescription</key>
  <string>缓境需要请求 Finder 将您选择的开发缓存移入废纸篓，以便您之后查看或恢复。</string>
  <key>NSDesktopFolderUsageDescription</key>
  <string>缓境需要扫描桌面中的开发项目，以识别您可以选择清理的依赖与构建目录。</string>
  <key>NSDocumentsFolderUsageDescription</key>
  <string>缓境需要扫描文稿中的开发项目，以识别您可以选择清理的依赖与构建目录。</string>
  <key>NSDownloadsFolderUsageDescription</key>
  <string>缓境需要扫描下载目录中的开发项目，以识别您可以选择清理的依赖与构建目录。</string>
  <key>NSRemovableVolumesUsageDescription</key>
  <string>缓境需要扫描您选择的外置磁盘，以识别开发依赖与构建目录。</string>
  <key>NSNetworkVolumesUsageDescription</key>
  <string>缓境需要扫描您选择的网络磁盘，以识别开发依赖与构建目录。</string>
</dict>
</plist>
